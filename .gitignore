# output/animations, site/_generated and site/_freeze are committed.
output/runs/*.csv
output/runs/*.log
output/runs/parts_*/
output/sensitivity/*/runs/
output/preview/
*.log

# Archives of earlier versions
*.zip

# Local settings and secrets
.env
.Renviron
.vscode/
.idea/
*.swp

# macOS
.DS_Store
._*
